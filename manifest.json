{
  "manifest_version": 3,
  "name": "Navigation Stats",
  "version": "1.0.1",
  "description": "Extension simple pour suivre vos statistiques de navigation",
  
  "permissions": [
    "tabs",
    "webNavigation",
    "storage"
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voir les statistiques"
  },
  
  "background": {
    "service_worker": "background.js"
  },
  
  "options_page": "options.html"
}
