{
  "manifest_version": 3,
  "name": "TabPulse",
  "version": "1.0.1",
  "description": "Track your browsing statistics - Simple and lightweight",
  
  "permissions": [
    "tabs",
    "webNavigation",
    "storage"
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "View Statistics",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  
  "background": {
    "service_worker": "background.js"
  },
  
  "options_page": "options.html",
  
  "web_accessible_resources": [
    {
      "resources": ["stats.html", "stats.js", "i18n.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
